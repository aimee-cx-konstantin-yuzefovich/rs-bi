# Режим работы (development или production)
NODE_ENV=development

# Секрет для NextAuth (обязателен в production). Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=rus-silica-bi-dev-secret-change-in-production

# URL для NextAuth (базовый URL приложения)
NEXTAUTH_URL=http://localhost:3000

# Секрет для проверки подписи SSO от WordPress. Должен совпадать с PROXY_SECRET в WordPress.
PROXY_SECRET=your_proxy_secret_here

# URL вебхука Bitrix24 (обязательно HTTPS, не локальный IP)
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_webhook_token/

# URL страницы входа WordPress (серверный)
WP_LOGIN_URL=https://bi-terminal.rus-silica.com/wp-login.php

# URL страницы входа WordPress (клиентский)
NEXT_PUBLIC_WP_LOGIN_URL=https://bi-terminal.rus-silica.com/wp-login.php

# URL базы данных SQLite
DATABASE_URL="file:./db/audit.db"

# Пароль для входа в режиме разработки (dev mode)
DEV_PASSWORD=dev1234
