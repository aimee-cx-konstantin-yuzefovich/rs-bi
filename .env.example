# Runtime mode. Local development: NODE_ENV=development.
NODE_ENV=production

# REQUIRED at runtime. The deployment gate rejects CHANGE_ME_* placeholders.
NEXTAUTH_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_BASE64_32
# Must match the WordPress SSO secret. Never use the build-only/documented placeholder.
PROXY_SECRET=CHANGE_ME_MATCH_WORDPRESS_SSO_SECRET

# Public HTTPS origin used by NextAuth in production.
NEXTAUTH_URL=https://bi-terminal.rus-silica.com

# Optional SERVER-ONLY webhook. Empty means demo mode; never use NEXT_PUBLIC_.
# Example format: https://your-portal.bitrix24.ru/rest/user-id/webhook-token/
BITRIX_WEBHOOK_URL=

# Server-side login URL (runtime).
WP_LOGIN_URL=https://bi-terminal.rus-silica.com/wp-login.php
# PUBLIC, embedded at BUILD time. Rebuild after changing this value.
NEXT_PUBLIC_WP_LOGIN_URL=https://bi-terminal.rus-silica.com/wp-login.php

# Host/PM2: absolute path to the EXISTING audit database; do not silently relocate it.
# This example preserves the repository's documented legacy location.
DATABASE_URL="file:/var/www/www-root/data/www/bi-terminal/prisma/db/audit.db"
# Compose overrides DATABASE_URL to file:/app/db/audit.db in its persistent volume.
# Local development may use file:./db/audit.db (relative to prisma/schema.prisma).
# Existing production tables need the one-time baseline in DEPLOYMENT.md.

# Host/PM2 standalone defaults. Compose deliberately overrides both values to
# PORT=3000 / HOSTNAME=0.0.0.0 so .env cannot desynchronize Docker networking.
PORT=3000
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Optional DEVELOPMENT ONLY credentials-login password (default: dev1234).
# DEV_PASSWORD=
