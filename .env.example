# Режим работы
NODE_ENV=production

# Секрет для NextAuth (сгенерируйте новый: openssl rand -base64 32)
NEXTAUTH_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_BASE64_32

# Правильный URL вашего сайта
NEXTAUTH_URL=https://bi-terminal.rus-silica.com

# Тот самый секретный ключ из вашего wp-config.php (сгенерируйте новый: openssl rand -base64 32)
PROXY_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_BASE64_32

# URL вебхука Bitrix24 (замените на свой реальный вебхук, когда он у вас появится)
BITRIX_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/example_token/

# URL страницы входа WordPress
WP_LOGIN_URL=https://bi-terminal.rus-silica.com/wp-login.php
NEXT_PUBLIC_WP_LOGIN_URL=https://bi-terminal.rus-silica.com/wp-login.php

# База данных
DATABASE_URL="file:./db/audit.db"
# Public Bitrix portal origin (no /rest/ path or credentials), used for company links.
BITRIX_PORTAL_URL=https://your-portal.bitrix24.ru
